{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "harbor-ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Harbor/Ollama (overlord)",
      "options": {
        "baseURL": "http://overlord:33821/v1"
      },
      "models": {
        "mistral:7b": {
          "name": "Mistral 7B",
          "description": "Fast and efficient general-purpose model"
        },
        "llama3:latest": {
          "name": "Llama 3",
          "description": "Meta's latest general-purpose model"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen2.5 Coder 14B",
          "description": "Specialized code generation and analysis model"
        },
        "codestral:latest": {
          "name": "Codestral",
          "description": "Mistral's official code model"
        },
        "mxbai-embed-large:latest": {
          "name": "MXBAI Embed Large",
          "description": "Embedding model for semantic search"
        }
      }
    }
  }
}